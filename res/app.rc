#include <windows.h>

/* ── Application icon ─────────────────────────────────────────── */
IDI_ICON1 ICON "icon.ico"

/* ── Version / metadata (controls what Explorer shows) ────────── */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Personal"
            VALUE "FileDescription",  "Game Catalogue"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Game Catalogue"
            VALUE "OriginalFilename", "Game Catalogue.exe"
            VALUE "ProductName",      "Game Catalogue"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
